# ==============================================================================
# LabNotes: HTTPS + SSL конфигурация Nginx (Порты 80 и 443)
# ==============================================================================
# ИНСТРУКЦИЯ ПО АКТИВАЦИИ:
# 1. Замените "your-domain.com" и "www.your-domain.com" на ваш реальный домен.
# 2. Получите сертификат Let's Encrypt или положите свои файлы в ./nginx/certs/
# 3. Замените содержимое файла "default.conf" данным файлом:
#    cp ./nginx/conf.d/https.conf.example ./nginx/conf.d/default.conf
# 4. Перезагрузите Nginx:
#    docker compose exec nginx nginx -s reload
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. HTTP Server: Перенаправление (301 Redirect) всех запросов на HTTPS
# ------------------------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name your-domain.com www.your-domain.com; # <-- УКАЖИТЕ ВАШ ДОМЕН

    # Путь для автоматического продления сертификатов Certbot / Let's Encrypt
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
    }

    # Постоянный редирект на защищенный протокол HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

# ------------------------------------------------------------------------------
# 2. HTTPS Server: Терминация SSL и безопасное проксирование в LabNotes
# ------------------------------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on; # Nginx 1.25+ директива для HTTP/2
    server_name your-domain.com www.your-domain.com; # <-- УКАЖИТЕ ВАШ ДОМЕН

    # ==========================================================================
    # ПУТИ К SSL СЕРТИФИКАТАМ:
    # 
    # ВАРИАНТ А: Бесплатный Let's Encrypt через Certbot:
    ssl_certificate /etc/letsencrypt/live/your-domain.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/your-domain.com/privkey.pem;
    #
    # ВАРИАНТ Б: Собственные сертификаты (положите их в папку ./nginx/certs/):
    # ssl_certificate /etc/nginx/certs/fullchain.pem;
    # ssl_certificate_key /etc/nginx/certs/privkey.pem;
    # ==========================================================================

    # Современные и безопасные протоколы TLS (без устаревших SSLv3, TLSv1, TLSv1.1)
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;

    # Кэширование SSL сессий для ускорения повторных подключений
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    # Заголовки безопасности браузера (HSTS, защита от clickjacking и MIME-sniffing)
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Максимальный размер загружаемых файлов (DOCX, изображения, скриншоты)
    client_max_body_size 100M;

    # Проксирование всех запросов в приложение LabNotes
    location / {
        proxy_pass http://app:8080;
        proxy_http_version 1.1;

        # Передача реальных параметров клиента бэкенду
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        # Поддержка WebSockets
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Таймауты для долгих запросов (импорт DOCX, загрузка архивов)
        proxy_connect_timeout 90s;
        proxy_send_timeout 90s;
        proxy_read_timeout 90s;
    }
}
