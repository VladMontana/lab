# ==============================================================================
# LabNotes: Caddy HTTP Configuration (Port 80)
# ==============================================================================
# Данный файл активен по умолчанию для работы по обычному HTTP (порт 80).
# Подходит для локального использования, тестирования по IP или первого запуска.
# ==============================================================================

:80 {
    # Проксирование всех запросов в контейнер LabNotes
    reverse_proxy app:8080 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Эффективное сжатие трафика (Zstandard и Gzip)
    encode zstd gzip

    # Максимальный размер загружаемых файлов (DOCX документы, изображения)
    request_body {
        max_size 100MB
    }

    # Логирование
    log {
        output stdout
        format console
    }
}
